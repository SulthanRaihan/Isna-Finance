# Inventory only; see the per-app examples and README.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# API uses the same public project key with the caller's verified user token.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Shared business-day timezone, independent of device/server local timezone.
BUSINESS_TIMEZONE=Asia/Jakarta

# Server-only FastAPI origin; use HTTPS in hosted environments.
API_BASE_URL=http://127.0.0.1:8000
