# M1 uses the public project key plus the caller's bearer token, preserving RLS.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Shared business-day timezone, independent of device/server local timezone.
BUSINESS_TIMEZONE=Asia/Jakarta

# Optional process environment only: JSON array of exact browser origins.
# Leave unset for the existing Next.js server-to-server API architecture.
# API_CORS_ORIGINS=[]
